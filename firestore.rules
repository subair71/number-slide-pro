rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /leaderboard/{entryId} {
      allow read: if true;
      function validEntry() {
        return request.auth != null
          && request.resource.data.keys().hasOnly(['uid', 'name', 'score', 'size', 'updatedAt'])
          && request.resource.data.keys().hasAll(['uid', 'name', 'score', 'size', 'updatedAt'])
          && request.resource.data.uid == request.auth.uid
          && entryId == request.auth.uid + '_' + string(request.resource.data.size)
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 30
          && request.resource.data.score is int
          && request.resource.data.score >= 0
          && request.resource.data.score <= 2500
          && request.resource.data.size in [3, 4, 5]
          && request.resource.data.updatedAt == request.time;
      }
      allow create: if validEntry();
      allow update: if validEntry()
        && resource.data.uid == request.auth.uid
        && request.resource.data.score > resource.data.score;
      allow delete: if false;
    }
  }
}
